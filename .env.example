# AgriAI 2.0 — Environment Variables
# Copy this file to .env.local and fill in your real keys.
# NEVER commit .env.local — it contains secrets!

# ─── AI (required for live answers) ───────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY            # chat + crop disease vision + voice transcription

# ─── Cloudflare Workers AI (fallback LLM + AI Studio image generation) ────────
CLOUDFLARE_API_KEY=YOUR_CLOUDFLARE_API_TOKEN  # API token with Workers AI permission
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID

# ─── Weather (primary provider) ───────────────────────────────────────────────
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY  # free tier: Current Weather + 5-day forecast

# ─── Optional extras ──────────────────────────────────────────────────────────
TAVILY_API_KEY=YOUR_TAVILY_API_KEY            # live web search with citations
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY    # voice output (read answers aloud)
UNSPLASH_ACCESS_KEY=YOUR_UNSPLASH_ACCESS_KEY  # market-price crop photos

# ─── Database (Render blueprint creates a managed Postgres automatically) ─────
# When DATABASE_URL is set, every write is mirrored to PostgreSQL and restored
# on restart. Without it, AgriAI uses a local JSON file (./data/db.json).
DATABASE_URL=postgresql://user:password@host:5432/agriai

# ─── Admin credentials (seeded on first run — CHANGE AFTER FIRST LOGIN) ───────
ADMIN_EMAIL=admin@agriai.gh
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ADMIN_NAME=AgriAI Admin

# ─── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
